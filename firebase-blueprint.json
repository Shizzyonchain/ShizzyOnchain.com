{
  "entities": {
    "Comment": {
      "title": "Comment",
      "description": "A user comment on the portfolio",
      "type": "object",
      "properties": {
        "author": {
          "type": "string",
          "description": "The name of the author"
        },
        "content": {
          "type": "string",
          "description": "The comment text"
        },
        "timestamp": {
          "type": "number",
          "description": "Unix timestamp"
        },
        "likes": {
          "type": "number",
          "description": "Number of likes"
        }
      },
      "required": ["author", "content", "timestamp", "likes"]
    }
  },
  "firestore": {
    "/portfolio_comments/{commentId}": {
      "schema": { "$ref": "#/entities/Comment" },
      "description": "Comments on Shizzy's portfolio"
    }
  }
}
